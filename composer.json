{
    "name": "github-aiko/laravel-ai",
    "description": "Fork of the Laravel AI SDK with additional providers (including vLLM).",
    "license": "MIT",
    "keywords": [
        "laravel",
        "ai",
        "vllm",
        "llm"
    ],
    "homepage": "https://github.com/Github-Aiko/laravel_ai",
    "support": {
        "issues": "https://github.com/Github-Aiko/laravel_ai/issues",
        "source": "https://github.com/Github-Aiko/laravel_ai"
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/container": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/json-schema": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/prompts": "^0.3.6",
        "laravel/serializable-closure": "^2.0",
        "prism-php/prism": "^0.100.0"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "mockery/mockery": "^1.6.12",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Laravel\\Ai\\": "src/"
        },
        "files": [
            "functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Laravel\\Ai\\AiServiceProvider"
            ]
        }
    }
}
